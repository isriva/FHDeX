# *****************************************************************
# Stochastic PDE of macroscopic fluctuation theory
#   d rho/dt = div[ D(rho) grad rho + sqrt(sigma(rho)/Lambda) eta ]
# Example: symmetric simple exclusion process (SSEP),
#   D = 1, sigma = 2 rho (1 - rho), for which S(k) = 1 - rhobar
# *****************************************************************

# *****************************************************************
# Run until nsteps == max_step or time == stop_time,
#     whichever comes first
# *****************************************************************
max_step  = 20000
#stop_time = 1.

seed = 0

amrex.fpe_trap_invalid = 1

# *****************************************************************
# Specific to this application
# *****************************************************************
# D(rho) and sigma(rho): amrex::Parser expressions in the variable rho
D_rho     = "1."
sigma_rho = "2.*rho*(1.-rho)"
#sigma_rho = "2.*rho"        # independent particles (Dean-Kawasaki with N = Lambda): S(k) = 1

Lambda = 1.e6               # noise strength sqrt(sigma/Lambda). Lambda*rho*dV is the particle
                            # count per cell (~73 here) and should be >> 1 (for the SSEP
                            # also Lambda*(1-rho)*dV, the holes per cell)
dorand = 1.                 # 0 = deterministic

# initial density: uniform rho0, or a piecewise-constant profile along x
# (n-1 breakpoints, then n values); rho is used as given (no renormalization)
rho0 = 0.3
#init_profile_x   = 0.5
#init_profile_val = 0.2 0.4

# independent realizations along the directions set to 1 (no transport there)
#is_ensemble_dir = 0 1

# *****************************************************************
# Structure factor S(k) = Lambda |drho_hat|^2 / (rhobar V), sampled every
# struct_fact_int steps after n_steps_skip and written with each plotfile
# (plt_SF* on the k-space grid and the shell average sf_kshell_<step>.txt)
# *****************************************************************
struct_fact_int = 10
n_steps_skip    = 5000

# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0  0.0  0.0
geometry.prob_hi     =  1.0  1.0  1.0
geometry.is_periodic =  1    1    1
# 0 = periodic (needs geometry.is_periodic = 1), 3 = wall with rho = 0
#bc_lo = 3 3
#bc_hi = 3 3

# *****************************************************************
# Resolution
# *****************************************************************
amr.n_cell        = 64 64 64
amr.max_grid_size = 32 32 32

# *****************************************************************
# Time step control
# *****************************************************************
adv.cfl      = 0.1          # fraction of the forward Euler limit 2/(max D * sum_d 4/dx_d^2)
#adv.fixed_dt = 1.e-5       # overrides the cfl estimate

# *****************************************************************
# Plotfile name and frequency
# *****************************************************************
amr.plot_file = plt_mft_    # root name of plot file
amr.plot_int  = 5000        # if negative then no plot files
